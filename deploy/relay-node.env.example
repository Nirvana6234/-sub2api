# =============================================================================
# 从节点环境变量（配合 docker-compose.relay-node.yml）
# cp relay-node.env.example relay-node.env 后修改
# =============================================================================

# 镜像（和主节点同一个镜像，用 NODE_ROLE=relay 区分角色）。主节点先升，再升从节点，两边版本保持一致。
SUB2API_IMAGE=weishaw/sub2api:latest

# 主节点主从通信地址：主节点 relay.master_listen_addr 的对外地址，必须直连（不经 CDN、不经会解密的代理）
RELAY_NODE_MASTER_ADDR=master.example.com:7443

# 主从通信根证书指纹：后台"从节点管理 → 密钥轮换 → 主从通信根证书"里复制。
# 多个用逗号分隔（轮换根证书期间新旧都写）。核对不上就拒绝连接。
RELAY_NODE_ROOT_FINGERPRINTS=

# 主节点对外的 HTTP 地址（现有站点地址）
RELAY_NODE_MASTER_URL=https://api.example.com

# 注册时显示的名称（激活时可改），可空
RELAY_NODE_DISPLAY_NAME=

# Let's Encrypt 注册邮箱（接收到期提醒），可空
RELAY_NODE_ACME_EMAIL=

TZ=Asia/Shanghai
