<Window x:Class="LanAi.RelayClient.AnnouncementWindow"
        Icon="/LanAi.RelayClient;component/Assets/LanAi.RelayClient.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公告" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" Background="#F7F8FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The list keeps the server's own ordering: unread first, newest first. -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <ListBox x:Name="AnnouncementList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionChanged="AnnouncementList_OnSelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- The unread dot, so a glance at the list agrees
                                     with the badge on the button that opened it. -->
                                <Ellipse Grid.Column="0" Width="6" Height="6"
                                         Fill="#2563EB" VerticalAlignment="Top" Margin="0,6,0,0"
                                         Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock Text="{Binding PublishedText}"
                                               Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="暂时没有公告"
                           Foreground="#9CA3AF" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="{Binding Selected.Title}"
                               FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Selected.PublishedText}"
                               Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <FlowDocumentScrollViewer x:Name="ContentViewer" Grid.Row="1"
                                          Margin="20,0,12,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="20,10,20,16">
                    <Button Content="在网页端查看" Click="OpenInBrowser_OnClick"
                            Padding="12,6" Background="Transparent" BorderBrush="#D1D5DB" />
                    <Button Content="关闭" Click="Close_OnClick"
                            Padding="16,6" Margin="8,0,0,0"
                            Background="Transparent" BorderBrush="#D1D5DB" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
