<Window x:Class="LanAi.RelayClient.PaymentWindow"
        Icon="/LanAi.RelayClient;component/Assets/LanAi.RelayClient.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="充值" Height="720" Width="560"
        WindowStartupLocation="CenterOwner" Background="#F7F8FA"
        Closing="Window_OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="AmountButton" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="AmountInput" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="InputBorder" Background="White" BorderBrush="#AAB3C0" BorderThickness="1" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,8" />
                            <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="#9CA3AF"
                                       Margin="10,8" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaymentActionButton" TargetType="Button">
            <Setter Property="Padding" Value="0,11" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="wxpay">
                    <Setter Property="Background" Value="#16A34A" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="充值" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="选择充值金额后，直接选择支付方式完成扫码支付。"
                       Foreground="#6B7280" Margin="0,4,0,18" />

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="当前账户余额" Foreground="#6B7280" FontSize="12" />
                    <TextBlock Text="{Binding CurrentBalanceText}" Foreground="#16A34A"
                               FontWeight="SemiBold" FontSize="18" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PaymentForm">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOrderActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="快捷金额" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PresetAmounts}" Margin="-3">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Tag="{Binding Amount}"
                                            Click="PresetAmount_OnClick" Style="{StaticResource AmountButton}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="自定义金额" FontWeight="SemiBold" Margin="0,16,0,7" />
                        <TextBox x:Name="CustomAmountInput" Tag="请输入充值金额"
                                 Text="{Binding CustomAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AmountInput}" />
                        <TextBlock Text="充值金额将按账户分组倍率折算为额度。" Foreground="#6B7280"
                                   FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="充值金额" Foreground="#6B7280" />
                            <TextBlock Text="{Binding CurrentAmount, StringFormat=￥{0:0.##}}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="手续费" Foreground="#6B7280" />
                            <TextBlock Text="{Binding FeeAmount, StringFormat=￥{0:0.##}}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="实际支付" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalPayAmount, StringFormat=￥{0:0.##}}"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBlock Text="{Binding CreditedAmount, StringFormat=到账额度约 ￥{0:0.##}}"
                                   Foreground="#2563EB" Margin="0,6,0,0" />

                        <ItemsControl x:Name="PaymentActionsPanel" ItemsSource="{Binding PaymentMethods}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionText}" Tag="{Binding Type}" IsEnabled="{Binding CanPay}"
                                            Click="PaymentAction_OnClick" Style="{StaticResource PaymentActionButton}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PaymentAvailabilityMessage}" Foreground="#B45309"
                                   Margin="0,10,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPaymentMethods}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="White" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding IsOrderActive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="请扫码完成支付" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Image x:Name="QrCodeImage"
                           Width="240" Height="240" Stretch="Uniform" Margin="0,10,0,0" />

                    <!-- 下单后上方金额表单会折叠，这里是扫码时唯一能核对付款金额的地方 -->
                    <TextBlock Text="本次支付" HorizontalAlignment="Center"
                               Foreground="#6B7280" FontSize="12" Margin="0,12,0,0" />
                    <TextBlock x:Name="OrderPayAmountText" Text="{Binding OrderPayAmountText}"
                               HorizontalAlignment="Center" Foreground="#111827"
                               FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding OrderAmountBreakdownText}"
                               HorizontalAlignment="Center" Foreground="#6B7280" FontSize="12" Margin="0,2,0,0"
                               Visibility="{Binding HasOrderAmountBreakdown, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding SecondsRemaining, StringFormat=订单剩余 {0} 秒}"
                               HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,10,0,0" />
                    <Button x:Name="CancelOrderButton" Content="取消订单"
                            Click="CancelOrder_OnClick" Padding="12,6"
                            HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Button Content="关闭" Click="Close_OnClick" Padding="0,8"
                    Background="Transparent" BorderBrush="#D1D5DB" />
        </StackPanel>
    </ScrollViewer>
</Window>
