<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanAi.RelayClient.App.Views.ExitConfirmationDialog"
        Title="退出"
        Width="440" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">

  <StackPanel Margin="24">
    <TextBlock Text="要退出助手吗？" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Name="ConsequenceText"
               Margin="0,10,0,22"
               Foreground="#4B5563"
               TextWrapping="Wrap" />

    <Grid ColumnDefinitions="*,12,*">
      <!-- Destructive on the left, safe default on the right: the same hand position
           that means "keep working" in the rest of the client. -->
      <Button Grid.Column="0" Content="完全退出助手"
              Click="FullExit_OnClick"
              Padding="12,9"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
              Foreground="#B91C1C" />

      <!-- Label set in code: 托盘 is a Windows word, and this dialog is the one place
           the user is told where the window went. -->
      <Button Grid.Column="2" Name="MinimizeButton"
              Click="Minimize_OnClick"
              Padding="12,9"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Background="#2563EB" BorderBrush="#2563EB" BorderThickness="1"
              Foreground="White" FontWeight="SemiBold"
              IsDefault="True" />
    </Grid>

    <!-- Kept, but deliberately not one of the two main choices. Signing out is the
         only way to change account, and this button is its only entry point in the
         whole client — dropping it would strand anyone with two accounts. -->
    <Button Content="退出登录（切换账号）"
            Click="SignOut_OnClick"
            Margin="0,14,0,0" Padding="0,4"
            HorizontalAlignment="Center"
            Background="Transparent" BorderThickness="0"
            Foreground="#6B7280" FontSize="12" />
  </StackPanel>
</Window>
