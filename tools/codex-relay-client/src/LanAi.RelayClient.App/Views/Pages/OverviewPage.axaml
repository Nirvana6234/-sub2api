<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanAi.RelayClient.ViewModels;assembly=LanAi.RelayClient.Core"
             xmlns:controls="clr-namespace:LanAi.RelayClient.Controls"
             x:Class="LanAi.RelayClient.App.Views.Pages.OverviewPage"
             x:DataType="vm:DashboardPageViewModel">

  <!-- The at-a-glance page: money, today's use, and one card per tool. Each card leads
       to its own page; only 启动 ChatGPT acts in place, because it is the reason most
       people open the window. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <Grid ColumnDefinitions="*,12,*">
        <Border Classes="card">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="暂时取不到" Classes="unavailable" DockPanel.Dock="Right"
                         IsVisible="{Binding Dashboard.Account.AccountUnavailable}" />
              <TextBlock Text="余额" Classes="cardTitle" />
            </DockPanel>
            <TextBlock Text="{Binding Dashboard.Account.BalanceText}" FontSize="26" FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBlock Text="{Binding Dashboard.Account.FrozenBalanceText, StringFormat='冻结 {0}'}"
                       Classes="label" />
            <!-- The entry is always available when the server supplies a recharge
                 URL; only the warning treatment follows the threshold. -->
            <DockPanel Margin="0,10,0,0" IsVisible="{Binding Dashboard.Account.CanRecharge}">
              <Button Content="去充值" Click="Recharge_OnClick"
                      Classes="recharge"
                      Classes.low="{Binding Dashboard.Account.BalanceIsLow}"
                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                      Padding="10,4" BorderThickness="1" />
              <TextBlock Text="余额偏低" Foreground="#DC2626" VerticalAlignment="Center"
                         IsVisible="{Binding Dashboard.Account.BalanceIsLow}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="暂时取不到" Classes="unavailable" DockPanel.Dock="Right"
                         IsVisible="{Binding Dashboard.Usage.UsageUnavailable}" />
              <TextBlock Text="今日用量（中转站）" Classes="cardTitle" />
            </DockPanel>
            <!-- Rows rather than three columns: token counts run to seven digits and
                 collided with the cost at the narrowest window width. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
              <TextBlock Grid.Row="0" Text="请求数" Classes="label" VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Dashboard.Usage.TodayRequestsText}"
                         FontSize="16" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Text="Token" Classes="label" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dashboard.Usage.TodayTokensText}"
                         FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Grid.Row="2" Text="消费" Classes="label" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dashboard.Usage.TodayCostText}"
                         FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,12,*,12,*">
        <Border Grid.Column="0" Classes="card">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="{Binding Dashboard.StartCodexLabel}"
                    Click="StartCodex_OnClick"
                    IsEnabled="{Binding Dashboard.CanStartCodex}"
                    Classes="primary"
                    Classes.installing="{Binding Dashboard.IsInstallingCodex}"
                    Classes.restart="{Binding Dashboard.RequiresCodexAccountRestart}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,8" Margin="0,10,0,0" FontWeight="SemiBold" BorderThickness="0" />
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="详情" Click="OpenCodex_OnClick"
                        Classes="link" Padding="0" />
                <TextBlock Text="Codex" Classes="cardTitle" />
              </DockPanel>
              <TextBlock Text="{Binding CodexStatusText}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding CodexRouteText}" Classes="label" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="设置" Click="OpenClaude_OnClick"
                    Classes="secondary" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,8" Margin="0,10,0,0" />
            <StackPanel>
              <TextBlock Text="Claude Code" Classes="cardTitle" />
              <TextBlock Text="{Binding ClaudeStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock Text="VS Code 插件等" Classes="label" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Column="4" Classes="card">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="管理" Click="OpenLocalProxy_OnClick"
                    Classes="secondary" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,8" Margin="0,10,0,0" />
            <StackPanel>
              <TextBlock Text="本地代理（今日）" Classes="cardTitle" />
              <!-- Straight to the official API with the user's own accounts: never on the
                   relay server's usage above, so it is shown here, from this machine. -->
              <TextBlock Text="{Binding Dashboard.LocalProxy.StatusText}"
                         Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Dashboard.LocalProxy.UsageText}"
                         Classes="label" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <Border Classes="card" Margin="0">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="暂时取不到" Classes="unavailable" DockPanel.Dock="Right"
                       IsVisible="{Binding Dashboard.Usage.TrendUnavailable}" />
            <TextBlock Text="近 7 日消费" Classes="cardTitle" />
          </DockPanel>

          <controls:UsageLineChart ItemsSource="{Binding Dashboard.Usage.CostTrend}"
                                   Height="140" Margin="0,10,0,0"
                                   Stroke="#2563EB" Fill="#1F2563EB"
                                   PointBrush="#2563EB" GridBrush="#E5E7EB"
                                   LabelBrush="#9CA3AF"
                                   IsVisible="{Binding Dashboard.Usage.HasTrend}" />

          <!-- Loaded fine, nothing to show. Said in words, because an empty card and a
               broken one look identical. -->
          <TextBlock Text="最近 7 天还没有用量记录"
                     Foreground="#9CA3AF" FontSize="12" Margin="0,10,0,0"
                     IsVisible="{Binding Dashboard.Usage.HasNoUsageYet}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
