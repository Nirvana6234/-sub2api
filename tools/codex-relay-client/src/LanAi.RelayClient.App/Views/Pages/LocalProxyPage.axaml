<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanAi.RelayClient.ViewModels;assembly=LanAi.RelayClient.Core"
             x:Class="LanAi.RelayClient.App.Views.Pages.LocalProxyPage"
             x:DataType="vm:DashboardPageViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#DC2626" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.toggle">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="Button.toggle.active">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Codex straight to the official API with one of the user's own ChatGPT accounts. It
       costs no balance, and it never falls back to the relay server on its own. Claude
       Code is not part of this: it always goes through the relay server. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <Border Classes="card">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.LocalProxy.UsageText, StringFormat='今日：{0}'}"
                       Classes="label" VerticalAlignment="Center" />
            <TextBlock Text="Codex 本地代理" Classes="cardTitle" />
          </DockPanel>
          <TextBlock Classes="hint" Margin="0,4,0,0"
                     Text="用你在中转站上自己的 ChatGPT 订阅账号，让 Codex 直接连官方：不经过中转站、不扣余额。只在客户端里使用该账号的授权，Codex 的配置不变；出错时只提醒、不会自动切回中转站。" />
          <TextBlock Text="{Binding Dashboard.LocalProxy.StatusText}" Margin="0,10,0,0" FontSize="12" />
          <TextBlock Text="{Binding Dashboard.LocalProxy.Error}" Classes="error" Margin="0,4,0,0"
                     IsVisible="{Binding Dashboard.LocalProxy.HasError}" />
          <TextBlock Text="{Binding Dashboard.LocalProxy.ActionMessage}" Foreground="#2563EB" FontSize="12"
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     IsVisible="{Binding Dashboard.LocalProxy.HasActionMessage}" />
          <TextBlock Text="{Binding Dashboard.LocalProxy.AccountsMessage}" Foreground="#6B7280" FontSize="12"
                     TextWrapping="Wrap" Margin="0,8,0,0"
                     IsVisible="{Binding Dashboard.LocalProxy.HasAccountsMessage}" />

          <ItemsControl ItemsSource="{Binding Dashboard.LocalProxy.Accounts}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalProxyAccountItem">
                <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Click="Toggle_OnClick"
                            Classes="toggle" Classes.active="{Binding IsActive}" VerticalAlignment="Center" />
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PlanText}" Classes="label" Margin="8,0,0,0"
                                   IsVisible="{Binding HasPlan}" VerticalAlignment="Center" />
                        <TextBlock Text="使用中" Foreground="#059669" FontSize="12" Margin="8,0,0,0"
                                   IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding StatusText}" Classes="hint" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="没有可用的 ChatGPT 订阅账号" Classes="hint" Margin="0,6,0,0"
                     IsVisible="{Binding !Dashboard.LocalProxy.HasAccounts}" />
        </StackPanel>
      </Border>

      <!-- Everything the local proxy cannot use, said in words rather than hidden. -->
      <Border Classes="card" Margin="0" IsVisible="{Binding Dashboard.LocalProxy.HasOtherAccounts}">
        <StackPanel>
          <TextBlock Text="暂不支持的账号" Classes="cardTitle" />
          <TextBlock Classes="hint" Margin="0,4,0,0"
                     Text="本地代理只支持订阅登录的 ChatGPT 账号；其他账号请继续经中转站使用。" />
          <ItemsControl ItemsSource="{Binding Dashboard.LocalProxy.OtherAccounts}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalProxyAccountItem">
                <TextBlock Classes="label" Margin="0,2,0,0">
                  <Run Text="{Binding Name}" />
                  <Run Text=" · " />
                  <Run Text="{Binding PlatformLabel}" />
                  <Run Text=" · " />
                  <Run Text="{Binding TypeLabel}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
