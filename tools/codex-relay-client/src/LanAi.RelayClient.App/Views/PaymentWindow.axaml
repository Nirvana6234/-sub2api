<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LanAi.RelayClient.ViewModels;assembly=LanAi.RelayClient.Core"
        x:Class="LanAi.RelayClient.App.Views.PaymentWindow"
        x:DataType="vm:PaymentViewModel"
        Title="充值" Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA">

  <Window.Styles>
    <Style Selector="Button.amount">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="8,12" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- WeChat green, Alipay blue. In WPF this was a DataTrigger on Type; here the
         class is set from the item's own Type in the template below. -->
    <Style Selector="Button.pay">
      <Setter Property="Padding" Value="0,11" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pay.wxpay">
      <Setter Property="Background" Value="#16A34A" />
    </Style>
    <Style Selector="Button.pay:disabled">
      <Setter Property="Background" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#64748B" />
    </Style>
  </Window.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="充值" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="选择充值金额后，直接选择支付方式完成扫码支付。"
                 Foreground="#6B7280" Margin="0,4,0,18" TextWrapping="Wrap" />

      <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
              Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="当前账户余额" Foreground="#6B7280" FontSize="12" />
          <TextBlock Text="{Binding CurrentBalanceText}" Foreground="#16A34A"
                     FontWeight="SemiBold" FontSize="18" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- Collapses once an order is live, which is why the QR panel below has to
           restate the amount: this is where it would otherwise have been read. -->
      <StackPanel IsVisible="{Binding !IsOrderActive}">

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="快捷金额" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding PresetAmounts}" Margin="-3">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaymentAmountOption">
                  <Button Content="{Binding Label}" Tag="{Binding Amount}"
                          Classes="amount" Click="PresetAmount_OnClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="自定义金额" FontWeight="SemiBold" Margin="0,16,0,7" />
            <TextBox Name="CustomAmountInput" Watermark="请输入充值金额"
                     Text="{Binding CustomAmountText}"
                     Padding="10,8" />
            <TextBlock Text="充值金额将按账户分组倍率折算为额度。" Foreground="#6B7280"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel Margin="0,2">
              <TextBlock Text="{Binding CurrentAmount, StringFormat='￥{0:0.##}'}"
                         DockPanel.Dock="Right" HorizontalAlignment="Right" />
              <TextBlock Text="充值金额" Foreground="#6B7280" />
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock Text="{Binding FeeAmount, StringFormat='￥{0:0.##}'}"
                         DockPanel.Dock="Right" HorizontalAlignment="Right" />
              <TextBlock Text="手续费" Foreground="#6B7280" />
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock Text="{Binding TotalPayAmount, StringFormat='￥{0:0.##}'}"
                         FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" />
              <TextBlock Text="实际支付" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{Binding CreditedAmount, StringFormat='到账额度约 ￥{0:0.##}'}"
                       Foreground="#2563EB" Margin="0,6,0,0" />

            <ItemsControl Name="PaymentActionsPanel" ItemsSource="{Binding PaymentMethods}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaymentMethodOption">
                  <Button Content="{Binding ActionText}" Tag="{Binding Type}"
                          IsEnabled="{Binding CanPay}"
                          Classes="pay"
                          Classes.wxpay="{Binding IsWeChat}"
                          Click="PaymentAction_OnClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding PaymentAvailabilityMessage}" Foreground="#B45309"
                       Margin="0,10,0,0" TextWrapping="Wrap"
                       IsVisible="{Binding !HasPaymentMethods}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                 TextWrapping="Wrap" Margin="0,0,0,8"
                 IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB"
                 TextWrapping="Wrap" Margin="0,0,0,8" />

      <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="White" CornerRadius="6"
              Padding="16" Margin="0,0,0,12"
              IsVisible="{Binding IsOrderActive}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="请扫码完成支付" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <Image Name="QrCodeImage" Width="240" Height="240" Stretch="Uniform" Margin="0,10,0,0" />

          <!-- 下单后上方金额表单会折叠，这里是扫码时唯一能核对付款金额的地方 -->
          <TextBlock Text="本次支付" HorizontalAlignment="Center"
                     Foreground="#6B7280" FontSize="12" Margin="0,12,0,0" />
          <TextBlock Name="OrderPayAmountText" Text="{Binding OrderPayAmountText}"
                     HorizontalAlignment="Center" Foreground="#111827"
                     FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
          <TextBlock Text="{Binding OrderAmountBreakdownText}"
                     HorizontalAlignment="Center" Foreground="#6B7280" FontSize="12" Margin="0,2,0,0"
                     IsVisible="{Binding HasOrderAmountBreakdown}" />

          <TextBlock Text="{Binding SecondsRemaining, StringFormat='订单剩余 {0} 秒'}"
                     HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,10,0,0" />
          <Button Name="CancelOrderButton" Content="取消订单"
                  Click="CancelOrder_OnClick" Padding="12,6"
                  HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Button Content="关闭" Click="Close_OnClick" Padding="0,8"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Background="Transparent" BorderBrush="#D1D5DB" BorderThickness="1" />
    </StackPanel>
  </ScrollViewer>
</Window>
