<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanAi.RelayClient.ViewModels;assembly=LanAi.RelayClient.Core"
             x:Class="LanAi.RelayClient.App.Views.RegistrationView"
             x:DataType="vm:RegistrationViewModel">

  <!-- Scrollable, which the WPF panel was not. With every optional field switched on
       — verification code, invitation code, promo code — plus an error line and the
       Turnstile notice, the form is taller than the 720px window, and the WPF version
       simply cut 返回登录 off the bottom edge. That left a user who reached this form
       by mistake with no way back to sign-in. Centred while it fits, scrolling once
       it does not. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel VerticalAlignment="Center" Margin="32">

      <TextBlock Text="注册账号" FontSize="24" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Text="使用邮箱创建共飞账号"
                 Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,24" />

      <TextBlock Text="邮箱" Margin="0,0,0,4" />
      <TextBox Name="EmailInput"
               Text="{Binding Email}"
               Padding="8,6" Margin="0,0,0,12" />

      <!-- Both password fields are masked TextBoxes with no binding on Text, for the
           same reason SignInView's is: RegistrationViewModel.SubmitAsync takes the two
           passwords as arguments precisely so they never become observable properties.
           Binding them here would compile and look right while undoing that. -->
      <TextBlock Text="密码" Margin="0,0,0,4" />
      <TextBox Name="PasswordInput"
               PasswordChar="●"
               Padding="8,6" Margin="0,0,0,12" />

      <TextBlock Text="确认密码" Margin="0,0,0,4" />
      <TextBox Name="ConfirmPasswordInput"
               PasswordChar="●"
               Padding="8,6" Margin="0,0,0,12"
               KeyDown="Field_OnKeyDown" />

      <!-- Each optional field is shown only when the server asks for it. The flags come
           from the public settings applied after the surface loads; before that they
           hold the conservative defaults, which is why an unapplied settings object
           renders a form that looks complete and rejects everything. -->
      <StackPanel IsVisible="{Binding ShowVerifyCode}">
        <TextBlock Text="邮箱验证码" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
          <Button Content="发送验证码" Click="SendVerifyCode_OnClick"
                  IsEnabled="{Binding CanSendVerifyCode}"
                  DockPanel.Dock="Right" Padding="8,6" Margin="8,0,0,0" />
          <TextBox Text="{Binding VerifyCode}" Padding="8,6" />
        </DockPanel>
        <TextBlock Text="{Binding VerifyCodeCountdownText}"
                   Foreground="#6B7280" Margin="0,-8,0,10"
                   IsVisible="{Binding HasVerifyCodeCountdown}" />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowInvitationCode}">
        <TextBlock Text="邀请码" Margin="0,0,0,4" />
        <TextBox Text="{Binding InvitationCode}" Padding="8,6" Margin="0,0,0,12" />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowPromoCode}">
        <TextBlock Text="优惠码" Margin="0,0,0,4" />
        <TextBox Text="{Binding PromoCode}" Padding="8,6" Margin="0,0,0,12" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 Margin="0,0,0,12"
                 IsVisible="{Binding HasError}" />

      <!-- Turnstile cannot be solved in a desktop window, so the client says so and
           hands the user to the web form rather than failing repeatedly in place. -->
      <TextBlock Text="请使用网页版完成安全验证"
                 Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,12"
                 IsVisible="{Binding TurnstileBlocked}" />
      <Button Content="打开网页版注册" Click="OpenRegistrationInBrowser_OnClick"
              IsVisible="{Binding TurnstileBlocked}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Padding="0,8" Margin="0,0,0,10" Background="Transparent"
              BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#2563EB" />

      <Button Content="注册" Click="SubmitRegistration_OnClick"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Padding="0,10" FontSize="15" Background="#2563EB" Foreground="White"
              BorderThickness="0" />

      <Button Content="返回登录" Click="BackToLogin_OnClick"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Padding="0,8" Margin="0,10,0,0" Background="Transparent"
              BorderThickness="0" Foreground="#6B7280" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
