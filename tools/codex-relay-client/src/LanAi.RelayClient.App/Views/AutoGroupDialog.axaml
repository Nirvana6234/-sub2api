<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanAi.RelayClient.App.Views"
        xmlns:vm="clr-namespace:LanAi.RelayClient.ViewModels;assembly=LanAi.RelayClient.Core"
        x:Class="LanAi.RelayClient.App.Views.AutoGroupDialog"
        x:DataType="local:AutoGroupDialog"
        Title="自动分组设置"
        Width="460" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <TextBlock Text="自动分组" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,8,0,14" Foreground="#64748B"
               TextWrapping="Wrap"
               Text="选择允许自动路由的 OpenAI 分组，并指定选择策略。" />

    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
            BorderThickness="1" CornerRadius="8" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Candidates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupItemViewModel">
              <CheckBox IsChecked="{Binding IsAutoGroupCandidateSelected, Mode=TwoWay}"
                        Margin="0,6">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RateLabel}" Foreground="#2563EB"
                               Margin="10,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding PeakLabel}" Foreground="#B45309" FontSize="11" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="自动选择策略" Foreground="#64748B" FontSize="12" Margin="0,0,0,5" />
      <ComboBox ItemsSource="{Binding StrategyLabels}"
                SelectedItem="{Binding SelectedStrategyLabel, Mode=TwoWay}"
                Padding="8,6" />
      <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626"
                 FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Width="84" Padding="10,6" Margin="0,0,8,0"
              Click="Cancel_OnClick" />
      <Button Content="确认并保存" Width="112" Padding="10,6"
              Background="#2563EB" Foreground="White" BorderThickness="0"
              Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</Window>
