<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanAi.RelayClient.App.Views.InlineCardWindow"
        Title="意图判断"
        Width="220" Height="44"
        SystemDecorations="None" CanResize="False"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Opacity="0.78">

  <!-- One message's analysis, pinned beside its bubble in WeChat (docs §6). See-through so the
       chat under it stays readable; solid while the pointer is on it. Filled from code by
       InlineCardHost: the windows are pooled and re-pointed at another card on every screen.

       Two fixed sizes, lines cut short with an ellipsis, the whole of it in the tooltip. Sized
       to its content, the card changed height with every text and, moved from the client's
       screen onto WeChat's on a two-screen setup with different scaling, came up narrow and tall;
       a fixed size also lets WeChatIntentViewModel keep cards from piling on each other.
       Expanded, 300x84 (ExpandedWidth / ExpandedHeight there): every judgement, with emotion,
       risk and advice written out under the headline. Compact, 220x44 (CardWidth / CardHeight):
       only the 「分析中…」 placeholder. -->
  <Border Name="Card" Background="#EEFFFFFF" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Name="RightItem" Header="判断得对" Click="Right_OnClick" />
        <MenuItem Name="WrongItem" Header="判断不对" Click="Wrong_OnClick" />
        <Separator />
        <MenuItem Header="本会话不再分析" Click="Mute_OnClick" />
      </ContextMenu>
    </Border.ContextMenu>
    <DockPanel>
      <Border Name="Stripe" DockPanel.Dock="Left" Width="3" CornerRadius="6,0,0,6" Background="#10B981" />
      <StackPanel Margin="7,0,7,0" VerticalAlignment="Center">
        <TextBlock Name="Headline" FontSize="12" FontWeight="SemiBold" Foreground="#111827"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="Advice" FontSize="11" Foreground="#4B5563" Margin="0,1,0,0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="Line1" FontSize="11" Foreground="#374151" Margin="0,2,0,0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False" />
        <TextBlock Name="Line2" FontSize="11" Foreground="#374151" Margin="0,1,0,0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False" />
        <TextBlock Name="Line3" FontSize="11" Foreground="#374151" Margin="0,1,0,0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
