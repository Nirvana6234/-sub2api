<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>LanAi.RelayClient.App</AssemblyName>
    <RootNamespace>LanAi.RelayClient.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>共飞-ChatGPT助手</AssemblyTitle>
    <Product>共飞-ChatGPT助手</Product>
    <ApplicationIcon>Assets\LanAi.RelayClient.ico</ApplicationIcon>

    <!-- The reason this project exists. WPF cannot be trimmed at all, which puts a
         163 MB floor under the current client; a trimmed Avalonia build measured
         14 MB zipped for an empty window. Both numbers are from this machine, not
         from documentation. -->
    <PublishTrimmed>true</PublishTrimmed>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Bindings resolved at compile time rather than by reflection. Under trimming
         the reflection kind fails the way this codebase's worst bugs fail: no
         exception, just an empty pane where the data should be. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Required, not optional. CodexAppLauncher activates the MSIX ChatGPT app
         through IApplicationActivationManager, a COM interface, and that is the whole
         point of the 启动 ChatGPT button.

         This was switched off first, on the reasoning that COM is not trim friendly
         and turning it off silenced an IL2026. It cost the client its main feature:
         the trimmed build issued a relay key, wrote ~/.codex, then died with
         "Built-in COM has been disabled via a feature switch" — after the config was
         already swapped. Everything up to the launch looked like it worked.

         Leave it on. If it ever produces a trim warning again, the answer is to
         suppress that specific warning with a justification, never to disable the
         feature switch. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Enabling COM roots the runtime's ComActivator, which carries a blanket IL2026
         ("Built-in COM support is not trim compatible"). It is unavoidable and it is
         about COM *server* activation — publishing managed classes as COM objects.
         This client only *consumes* one built-in Windows COM class, through a
         [ComImport] interface with an explicit GUID that is referenced directly and so
         is rooted by the trimmer.

         Demoted for the ILLink pass only. NoWarn would have been wrong: $(NoWarn)
         flows into both the compile-time trim analyser and the linker, so silencing
         IL2026 there would also silence it on this project's own code — and the three
         worst bugs found during this port were all reflection-JSON IL2026s in our own
         code, each of which failed silently at runtime rather than crashing.

         The compile-time analyser therefore still errors on our code. What is demoted
         is only the linker's own framework-level warning, and the publish output must
         be read: any IL2026 naming a LanAi.* member is a real defect, not this. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanAi.RelayClient.Core\LanAi.RelayClient.Core.csproj" />
  </ItemGroup>

  <!-- Window and tray icon. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The bundled 759 MB msix is gone: CodexInstaller downloads on demand, and this
       directory is the manual drop point for an offline machine. The
       README is both the guidance for that step and what makes the directory exist. -->
  <ItemGroup>
    <Content Include="..\..\codex-installer\README.txt">
      <Link>codex-installer\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Optional WeChat screen reader for 「探索」 → 微信消息意图判断, Windows only
       (docs/WECHAT_INTENT_ASSISTANT.md §4.6).

       Opt-in, and deliberately not part of the release package in phase 1: the feature is
       for the developer's own testing, and the reader is a self-contained exe of its own
       (about 14 MB trimmed) that every user's download and update would otherwise carry.
       Build with -p:IncludeWeChatReader=true to get it next to the client.

       `dotnet publish` through Exec rather than the MSBuild task: the reader has its own
       target framework (a Windows SDK one) and its own publish settings, and an MSBuild call
       would hand it this project's global properties. -->
  <Target Name="IncludeWeChatReader" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IncludeWeChatReader)' == 'true' and ($(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <PropertyGroup>
      <!-- No trailing separator: in the Exec below it would escape the closing quote. -->
      <WeChatReaderPublishDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)wechat-reader</WeChatReaderPublishDir>
    </PropertyGroup>
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(MSBuildProjectDirectory)\..\LanAi.RelayClient.WeChatReader\LanAi.RelayClient.WeChatReader.csproj&quot; -c Release -o &quot;$(WeChatReaderPublishDir)&quot; --nologo" />
    <ItemGroup>
      <Content Include="$(WeChatReaderPublishDir)\wechat-reader.exe">
        <Link>wechat-reader\wechat-reader.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

  <!-- The same opt-in for macOS: the reader there is Swift (src/LanAi.RelayClient.WeChatReader.Mac),
       which only a Mac can build. On a Mac it is built here; anywhere else — the release runner
       cross-compiles macOS from Windows — a binary built on a Mac beforehand is taken from
       WeChatReaderMacBinary. It lands in Contents/MacOS/wechat-reader/ once build-app.py copies the
       publish output into the bundle, and build-app.py marks it executable. -->
  <Target Name="IncludeWeChatReaderMac" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IncludeWeChatReader)' == 'true' and $(RuntimeIdentifier.StartsWith('osx'))">
    <PropertyGroup>
      <WeChatReaderMacPackage>$(MSBuildProjectDirectory)\..\LanAi.RelayClient.WeChatReader.Mac</WeChatReaderMacPackage>
      <WeChatReaderMacBinary Condition="'$(WeChatReaderMacBinary)' == ''">$(WeChatReaderMacPackage)/.build/apple/Products/Release/wechat-reader</WeChatReaderMacBinary>
    </PropertyGroup>
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Command="swift build -c release --arch arm64 --arch x86_64 --package-path &quot;$(WeChatReaderMacPackage)&quot;" />
    <Error Condition="!Exists('$(WeChatReaderMacBinary)')"
           Text="IncludeWeChatReader for macOS needs the Swift reader built on a Mac first: run src/LanAi.RelayClient.WeChatReader.Mac/build.sh there, or pass -p:WeChatReaderMacBinary=&lt;path&gt;. Not found: $(WeChatReaderMacBinary)" />
    <ItemGroup>
      <Content Include="$(WeChatReaderMacBinary)">
        <Link>wechat-reader/wechat-reader</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

  <!-- Optional bundled context filter, Windows only.

       Keyed on the RuntimeIdentifier and not on the build machine's OS: the macOS
       artifact is cross-compiled from a Windows runner, so an OS test would ship a
       Windows .exe inside the .app. With no RID (a plain build or the test run) it
       is included, so the toggle can be exercised locally.

       The <Content> is declared inside the target on purpose — an ItemGroup condition
       outside one is evaluated before any target runs, so the first build would fetch
       the file and then not bundle it. ContinueOnError because the fetch reaches the
       network: offline, or a GitHub rate limit, must not fail the build of a client
       that is designed to run without this file. -->
  <Target Name="EnsureBundledContextFilter" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win')))">
    <Exec Condition="'$(SkipContextFilterDownload)' != 'true'"
          ContinueOnError="WarnAndContinue"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\fetch-context-filter.ps1&quot; -Version latest -OutputDirectory &quot;$(MSBuildProjectDirectory)\bin\context-filter&quot;" />
    <ItemGroup>
      <Content Include="bin\context-filter\context-filter.exe"
               Condition="Exists('$(MSBuildProjectDirectory)\bin\context-filter\context-filter.exe')">
        <Link>context-filter\context-filter.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

</Project>
