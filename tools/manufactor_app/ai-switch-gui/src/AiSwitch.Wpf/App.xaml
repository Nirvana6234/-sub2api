<Application x:Class="LanAi.Workspace.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanAi.Workspace.Wpf.ViewModels"
             xmlns:views="clr-namespace:LanAi.Workspace.Wpf.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WorkspaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                <views:ProjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectSessionsViewModel}">
                <views:ProjectSessionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
                <views:TerminalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                <views:ChatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}">
                <views:ConnectionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GatewayViewModel}">
                <views:GatewayView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountCenterViewModel}">
                <views:AccountCenterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TransitCenterViewModel}">
                <views:TransitCenterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <views:StatsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExtensionsViewModel}">
                <views:ExtensionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfileView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
