<UserControl x:Class="LanAi.Workspace.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     Margin="0,4,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource WorkspaceTextBoxStyle}"
                     ToolTip="搜索标题、项目或摘要" />
            <ComboBox Grid.Column="3"
                      Margin="0,4,0,0"
                      ItemsSource="{Binding CliFilters}"
                      SelectedItem="{Binding SelectedCliFilter}"
                      Style="{StaticResource WorkspaceComboBoxStyle}" />
            <Button Grid.Column="5"
                    Margin="0,4,0,0"
                    Content="刷新索引"
                    Command="{Binding RefreshHistoryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="15,12" Background="#EAF7EE" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AppIcon Kind="History" Width="14" Height="14" Foreground="#247A3D" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="会话历史与 API 解耦" FontSize="11.5" FontWeight="SemiBold" Foreground="#247A3D" />
                    <TextBlock Text="{Binding StatusNotice}"
                               Margin="0,4,0,0"
                               FontSize="10.5"
                               Foreground="#3E7350"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Padding="9,5" Background="#DDF1E3" CornerRadius="8" VerticalAlignment="Center">
                    <TextBlock Text="设计目标" FontSize="9.5" FontWeight="SemiBold" Foreground="#247A3D" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,0,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="会话" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="项目" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
            <TextBlock Grid.Column="2" Text="CLI / 连接" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
            <TextBlock Grid.Column="3" Text="更新时间" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="18,15" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <Border Margin="8,0,0,0" Padding="6,3" Background="#FFF3F3F5" CornerRadius="7">
                                            <TextBlock Text="{Binding Status}" FontSize="8.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,6,18,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Project}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Cli}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Connection}" Margin="0,4,0,0" FontSize="9.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding UpdatedAt}" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="4"
                                        Content="继续"
                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="30"
                                        Padding="14,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
