<UserControl x:Class="LanAi.Workspace.Wpf.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0" Padding="24">
                <StackPanel>
                    <TextBlock Text="账号" Style="{StaticResource EyebrowTextStyle}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" Text="用户名"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Username}"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,0,10" Text="邮箱"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Email}"
                                   FontSize="13" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,10" Text="角色"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding RoleLabel}"
                                   FontSize="13" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,0,10" Text="余额"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Text="{Binding BalanceText}"
                                   FontSize="13" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,0,10" Text="冻结余额"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Text="{Binding FrozenBalanceText}"
                                   FontSize="13" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="来源"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SourceText}"
                                   FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Border Margin="0,18,0,0" Padding="14" CornerRadius="10"
                            Background="#FFF7F7F9">
                        <TextBlock Text="{Binding SessionKindText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>

                    <Button Content="退出登录"
                            Command="{Binding SignOutCommand}"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
