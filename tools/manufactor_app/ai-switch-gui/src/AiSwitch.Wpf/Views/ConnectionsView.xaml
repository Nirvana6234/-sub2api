<UserControl x:Class="LanAi.Workspace.Wpf.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls">
    <UserControl.Resources>
        <Style x:Key="ClaudeGptTargetToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFC7D9EF" />
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF9FBFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackupUpstreamToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#FFD4D9E0" CornerRadius="11">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3" Fill="White" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="ConnectionsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Margin="0,0,0,16"
                    Background="White"
                    BorderBrush="#FFD8E1EC"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid Margin="18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                            <controls:AppIcon Kind="Connections" Width="19" Height="19"
                                              Foreground="{StaticResource AccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="跨客户端模型路由" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="通过本机中转读取可用模型，也可展开后精确调整每一级映射"
                                       FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="10,6" Background="#FFF3F7FC" CornerRadius="8" VerticalAlignment="Center">
                            <TextBlock Text="退出软件自动恢复原配置" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="#FFE8ECF1" />

                    <StackPanel>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="4" Height="38" Background="#FF007AFF" CornerRadius="2" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Claude Code 使用 GPT / Grok" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="Opus、Sonnet、Haiku 可映射到 GPT 或 Grok 模型" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="映射" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding ClaudeGptMappingStatus}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="状态" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TertiaryTextBrush}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsClaudeGptEnabled}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ClaudeGptStatusText}" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                <Button Content="配置" Command="{Binding ConfigureClaudeGptCommand}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsClaudeGptEnabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="停用并恢复" Command="{Binding DisableClaudeGptCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding IsClaudeGptEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Grid>

                        <Border Margin="18,0,18,16" Padding="16,14" Background="#FFF7F9FC" CornerRadius="9"
                                Visibility="{Binding IsClaudeGptEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="接入目标" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Content="Grok"
                                                          IsChecked="{Binding IsClaudeGptTargetGrokSelected, Mode=OneWay}"
                                                          Command="{Binding SelectClaudeGptTargetPlatformCommand}"
                                                          CommandParameter="Grok"
                                                          Style="{StaticResource ClaudeGptTargetToggleStyle}" />
                                            <ToggleButton Grid.Column="2"
                                                          Content="GPT"
                                                          IsChecked="{Binding IsClaudeGptTargetGptSelected, Mode=OneWay}"
                                                          Command="{Binding SelectClaudeGptTargetPlatformCommand}"
                                                          CommandParameter="GPT"
                                                          Style="{StaticResource ClaudeGptTargetToggleStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="取消" Command="{Binding CancelClaudeGptConfigurationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="8,0,0,0" Content="启用路由" Command="{Binding EnableClaudeGptCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                                    <TextBlock Text="Claude Code 中选择" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="实际调用的 GPT / Grok 模型" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Row="1" Text="Opus · 复杂任务" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Sonnet · 日常编码" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="Haiku · 快速轻量" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,4" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding ClaudeGptModels}" Text="{Binding ClaudeGptOpusModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,4" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding ClaudeGptModels}" Text="{Binding ClaudeGptSonnetModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    <ComboBox Grid.Row="3" Grid.Column="2" Margin="0,4" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding ClaudeGptModels}" Text="{Binding ClaudeGptHaikuModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Margin="18,0" Background="#FFE8ECF1" />

                    <StackPanel>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="4" Height="38" Background="#FFFF7A45" CornerRadius="2" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Codex 使用 Claude / Grok" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="主会话和 Review 可映射到 Claude 或 Grok 模型" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="运行策略" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding CodexClaudeMappingStatus}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="状态" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TertiaryTextBrush}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsCodexClaudeEnabled}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding CodexClaudeStatusText}" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                <Button Content="配置" Command="{Binding ConfigureCodexClaudeCommand}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCodexClaudeEnabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="停用并恢复" Command="{Binding DisableCodexClaudeCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding IsCodexClaudeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Grid>

                        <Border Margin="18,0,18,16" Padding="16,14" Background="#FFF9F8F6" CornerRadius="9"
                                Visibility="{Binding IsCodexClaudeEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="接入目标" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Content="Claude"
                                                          IsChecked="{Binding IsCodexClaudeTargetClaudeSelected, Mode=OneWay}"
                                                          Command="{Binding SelectCodexClaudeTargetPlatformCommand}"
                                                          CommandParameter="Claude"
                                                          Style="{StaticResource ClaudeGptTargetToggleStyle}" />
                                            <ToggleButton Grid.Column="2"
                                                          Content="Grok"
                                                          IsChecked="{Binding IsCodexClaudeTargetGrokSelected, Mode=OneWay}"
                                                          Command="{Binding SelectCodexClaudeTargetPlatformCommand}"
                                                          CommandParameter="Grok"
                                                          Style="{StaticResource ClaudeGptTargetToggleStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="取消" Command="{Binding CancelCodexClaudeConfigurationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="8,0,0,0" Content="启用路由" Command="{Binding EnableCodexClaudeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Codex 中选择" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="实际调用的 Claude / Grok 模型" FontSize="10.2" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Row="1" Text="主会话 · 交互与 exec" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Review · 代码审查" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="推理强度" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,4"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              ItemsSource="{Binding CodexClaudeModels}"
                                              Text="{Binding CodexClaudeDefaultModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,4"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              ItemsSource="{Binding CodexClaudeModels}"
                                              Text="{Binding CodexClaudeReviewModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    <ComboBox Grid.Row="3" Grid.Column="2" Margin="0,4"
                                              ItemsSource="{Binding CodexClaudeReasoningEfforts}"
                                              SelectedItem="{Binding CodexClaudeReasoningEffort, Mode=TwoWay}"
                                              Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16" Padding="16" Background="#FFFFF4E5" BorderBrush="#2CFF9F0A" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding HasMutationNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding MutationNotice}" FontSize="12" Foreground="#7D520F" TextWrapping="Wrap" />
            </Border>

            <Border x:Name="ConnectionEditorPanel" Margin="0,0,0,18" Padding="20" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsNewEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionEditor.EditorTitle}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding ConnectionEditor.FixedNameHint}" Margin="0,5,0,0" FontSize="11.5" Foreground="{StaticResource TertiaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="导入当前客户端配置" Command="{Binding ImportCurrentClientConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0" Content="取消" Command="{Binding CancelConnectionEditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="来源模板" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ProviderTemplates}"
                                  SelectedItem="{Binding SelectedProviderTemplate}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource WorkspaceComboBoxStyle}" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Content="套用模板"
                                Command="{Binding ApplyProviderTemplateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="来源名称" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ConnectionEditor.Name, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding ConnectionEditor.IsFixed}"
                                 Style="{StaticResource WorkspaceTextBoxStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备注" VerticalAlignment="Top" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox Grid.Column="1"
                                 Height="52"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                  Text="{Binding ConnectionEditor.Notes, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource WorkspaceTextBoxStyle}" />
                    </Grid>

                    <Border Margin="0,0,0,15"
                            Padding="13,12"
                            Background="#FFF7FAFE"
                            BorderBrush="#FFCEE0F2"
                            BorderThickness="1"
                            CornerRadius="11"
                            Visibility="{Binding ConnectionEditor.SupportsDashboardAddress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ConnectionEditor.DashboardAddressLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding ConnectionEditor.DashboardUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding ConnectionEditor.DashboardAddressToolTip}"
                                         Style="{StaticResource WorkspaceTextBoxStyle}" />
                                <TextBlock Margin="1,6,0,0"
                                           Text="{Binding ConnectionEditor.DashboardAddressHint}"
                                           FontSize="11"
                                           Foreground="{StaticResource TertiaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="客户端地址与密钥" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="57" /><RowDefinition Height="57" /><RowDefinition Height="57" /><RowDefinition Height="57" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="服务地址（留空保持）" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="替换密钥（留空保持）" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="清除" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="1" Text="Codex" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,10,4" Text="{Binding ConnectionEditor.CodexBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,3,10,2">
                            <PasswordBox Padding="9,6" PasswordChanged="CodexSecret_OnPasswordChanged" />
                            <TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.CodexCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearCodexSecret}" />

                        <TextBlock Grid.Row="2" Text="Claude" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,10,4" Text="{Binding ConnectionEditor.ClaudeBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,3,10,2">
                            <PasswordBox Padding="9,6" PasswordChanged="ClaudeSecret_OnPasswordChanged" />
                            <TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.ClaudeCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearClaudeSecret}" />

                        <TextBlock Grid.Row="3" Text="Gemini" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,10,4" Text="{Binding ConnectionEditor.GeminiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,3,10,2">
                            <PasswordBox Padding="9,6" PasswordChanged="GeminiSecret_OnPasswordChanged" />
                            <TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.GeminiCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearGeminiSecret}" />

                        <TextBlock Grid.Row="4" Text="Grok" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,10,4" Text="{Binding ConnectionEditor.GrokBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,3,10,2">
                            <PasswordBox Padding="9,6" PasswordChanged="GrokSecret_OnPasswordChanged" />
                            <TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.GrokCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearGrokSecret}" />
                    </Grid>

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelConnectionEditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Margin="10,0,0,0" Content="安全保存" Command="{Binding SaveConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="备用上游" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Margin="0,4,0,0" Text="个人账号全部不可调度时，按下方已启用来源的顺位自动接续。" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Margin="0,0,16,0"
                            Command="{Binding AddConnectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="添加一个新的远程上游来源">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="Plus" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" Text="新增上游" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Width="1" Height="24" Margin="0,0,16,0" Background="{StaticResource HairlineBrush}" />
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="{Binding BackupUpstreamStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="3"
                                  IsChecked="{Binding IsBackupUpstreamEnabled, Mode=OneWay}"
                                  Command="{Binding ToggleBackupUpstreamCommand}"
                                  Style="{StaticResource BackupUpstreamToggleStyle}"
                                  ToolTip="控制个人账号不可调度时是否允许使用备用上游" />
                </Grid>
            </Grid>

            <Border Margin="0,0,0,2" Padding="14,9" Background="#FFF2F4F7" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="来源" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                    <TextBlock Grid.Column="2" Margin="10,0" Text="服务地址" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                    <TextBlock Grid.Column="3" Text="支持客户端" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                    <TextBlock Grid.Column="4" Margin="12,0,0,0" Text="密钥状态" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                    <TextBlock Grid.Column="5" Text="操作" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl x:Name="BackupItems"
                          ItemsSource="{Binding BackupConnections}"
                          AllowDrop="True"
                          DragOver="BackupItems_OnDragOver"
                          DragLeave="BackupItems_OnDragLeave"
                          Drop="BackupItems_OnDrop">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="0" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#FFF5F9FF" />
                                            <Setter Property="BorderBrush" Value="#FF72AEEF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                <Condition Binding="{Binding DropInsertAfter}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF5F9FF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1,3,1,1" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                <Condition Binding="{Binding DropInsertAfter}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF5F9FF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1,1,1,3" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="48" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                        <Border Width="18"
                                                Height="30"
                                                Background="Transparent"
                                                Cursor="SizeAll"
                                                Tag="{Binding}"
                                                ToolTip="拖动调整备用顺位"
                                                Visibility="{Binding IsBackupEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                PreviewMouseLeftButtonDown="BackupDragHandle_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseMove="BackupDragHandle_OnPreviewMouseMove">
                                            <controls:AppIcon Kind="GripVertical" Width="11" Height="11" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1" Width="26" Height="26" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" VerticalAlignment="Center">
                                            <controls:AppIcon Kind="{Binding IconKey}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Margin="5,0,7,0"
                                            Padding="3,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.ToggleConnectionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Margin="7,0,0,0" Padding="5,2" Background="#FFF1F1F3" CornerRadius="6">
                                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding Endpoint}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Margin="9,0,0,0" Text="{Binding CredentialState}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="5"
                                            Style="{StaticResource QuietIconButtonStyle}"
                                            ToolTip="展开来源操作"
                                            Command="{Binding DataContext.ToggleConnectionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <controls:AppIcon Kind="ChevronRight" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                            <controls:AppIcon.Style>
                                                <Style TargetType="controls:AppIcon">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers>
                                                </Style>
                                            </controls:AppIcon.Style>
                                        </controls:AppIcon>
                                    </Button>
                                </Grid>

                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Padding="14,12" Background="#FFF7F9FC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="来源操作" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <Button Margin="0,0,8,0" IsEnabled="{Binding CanApply}" Content="{Binding ApplyActionLabel}" Command="{Binding DataContext.ApplyConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Margin="0,0,8,0" Content="测试连接" IsEnabled="{Binding CanOperate}" Command="{Binding DataContext.ValidateConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Margin="0,0,8,0" Content="{Binding DashboardActionLabel}" ToolTip="{Binding DashboardActionHint}" IsEnabled="{Binding CanOpenDashboard}" Command="{Binding DataContext.OpenConnectionDashboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Margin="0,0,8,0" Content="编辑来源" IsEnabled="{Binding CanOperate}" Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="删除来源" Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#C83E42">
                                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding CanDelete}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Margin="14,12,14,0" Padding="12,10" Background="#FFF5F2F2" BorderBrush="#22C83E42" BorderThickness="1" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="确认删除这个远程来源？" FontSize="12.5" FontWeight="SemiBold" Foreground="#9D292D" />
                                            <TextBlock Text="不会删除项目、历史或本机中转站；已配置的官方客户端保持当前状态。" Margin="0,4,0,0" FontSize="11" Foreground="#7B4648" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="取消" Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Margin="8,0,0,0" Content="确认删除" Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Background="#C83E42" BorderBrush="#C83E42" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Editing stays beside the selected source.  The outer card keeps the
                                     row binding; the inner card intentionally switches back to the page
                                     view model so the single secure editor remains the source of truth. -->
                                <Border Margin="14,12,14,14"
                                        Padding="18"
                                        Background="#FFF8FBFF"
                                        BorderBrush="#FFB9D7F6"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="编辑此来源" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="在当前卡片内完成修改；地址或密钥留空均代表维持该客户端原有配置。"
                                                           Margin="0,5,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TertiaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="导入当前客户端配置" Command="{Binding ImportCurrentClientConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Margin="8,0,0,0" Content="收起" Command="{Binding CancelConnectionEditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="来源名称" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ConnectionEditor.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding ConnectionEditor.IsFixed}"
                                                     Style="{StaticResource WorkspaceTextBoxStyle}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,12"
                                              Visibility="{Binding ConnectionEditor.ShowsNotesEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="备注" VerticalAlignment="Top" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBox Grid.Column="1" Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                                                     Text="{Binding ConnectionEditor.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WorkspaceTextBoxStyle}" />
                                        </Grid>

                                        <Border Margin="0,0,0,12"
                                                Padding="12"
                                                Background="#FFF7FAFE"
                                                BorderBrush="#FFCEE0F2"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Visibility="{Binding ConnectionEditor.SupportsLocalSub2ApiPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="本机中转&#x0a;项目目录"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBox Text="{Binding ConnectionEditor.LocalGatewayPathDisplay, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             ToolTip="{Binding ConnectionEditor.LocalGatewayPathDisplay}"
                                                             Style="{StaticResource WorkspaceTextBoxStyle}" />
                                                    <TextBlock Margin="1,5,0,0"
                                                               Text="请选择本机中转项目目录；启动服务时会从对应工作区读取原生启停脚本。"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TertiaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="选择目录"
                                                        Command="{Binding SelectLocalSub2ApiPathCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>

                                        <Border Margin="0,0,0,12" Padding="12" Background="White" BorderBrush="#FFCEE0F2" BorderThickness="1" CornerRadius="10"
                                                Visibility="{Binding ConnectionEditor.ShowsDashboardAddressEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ConnectionEditor.DashboardAddressLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBox Text="{Binding ConnectionEditor.DashboardUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ConnectionEditor.DashboardAddressToolTip}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                                    <TextBlock Margin="1,5,0,0" Text="{Binding ConnectionEditor.DashboardAddressHint}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="客户端地址与密钥" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="57" /><RowDefinition Height="57" /><RowDefinition Height="57" /><RowDefinition Height="57" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="服务地址（留空维持）" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="替换密钥（留空维持）" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="清除" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Text="Codex" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,9,4" Text="{Binding ConnectionEditor.CodexBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,3,8,2"><PasswordBox Padding="9,6" PasswordChanged="CodexSecret_OnPasswordChanged" /><TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.CodexCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearCodexSecret}" />

                                            <TextBlock Grid.Row="2" Text="Claude" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,9,4" Text="{Binding ConnectionEditor.ClaudeBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,3,8,2"><PasswordBox Padding="9,6" PasswordChanged="ClaudeSecret_OnPasswordChanged" /><TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.ClaudeCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <CheckBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearClaudeSecret}" />

                                            <TextBlock Grid.Row="3" Text="Gemini" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,9,4" Text="{Binding ConnectionEditor.GeminiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,3,8,2"><PasswordBox Padding="9,6" PasswordChanged="GeminiSecret_OnPasswordChanged" /><TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.GeminiCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <CheckBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearGeminiSecret}" />

                        <TextBlock Grid.Row="4" Text="Grok" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,10,4" Text="{Binding ConnectionEditor.GrokBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,3,10,2">
                            <PasswordBox Padding="9,6" PasswordChanged="GrokSecret_OnPasswordChanged" />
                            <TextBlock Margin="2,3,0,0" Text="{Binding ConnectionEditor.GrokCredentialHint}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding ConnectionEditor.ClearGrokSecret}" />
                                        </Grid>
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="取消" Command="{Binding CancelConnectionEditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Margin="8,0,0,0" Content="保存此来源" Command="{Binding SaveConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
