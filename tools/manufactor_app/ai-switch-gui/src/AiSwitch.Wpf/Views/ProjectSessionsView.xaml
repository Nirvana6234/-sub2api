<UserControl x:Class="LanAi.Workspace.Wpf.Views.ProjectSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="返回项目中心"
                    Command="{Binding BackToProjectsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinHeight="34"
                    Padding="14,0"
                    VerticalAlignment="Center" />
            <Button Grid.Column="3"
                    Content="新建会话"
                    Command="{Binding StartNewConversationCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinHeight="34"
                    Padding="16,0"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="20,18"
                Background="#FFF7FAFE"
                BorderBrush="#FFCEE0F2"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                    <controls:AppIcon Kind="Projects"
                                      Width="20"
                                      Height="20"
                                      Foreground="{StaticResource AccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Margin="9,0,0,0" Padding="7,3" Background="#FFFFFFFF" CornerRadius="7">
                            <TextBlock Text="项目会话"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ProjectPath}"
                               Margin="0,6,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,7" Background="#FFFFFFFF" CornerRadius="10" VerticalAlignment="Center">
                      <StackPanel>
                        <TextBlock Text="当前状态" FontSize="8.5" Foreground="{StaticResource TertiaryTextBrush}" />
                        <TextBlock Text="{Binding ProjectStatus}"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                      </StackPanel>
                    </Border>
                    <Button Margin="8,0,0,0"
                            Content="保存工作配置"
                            Command="{Binding CaptureProjectProfileCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Content="应用工作配置"
                            Command="{Binding ApplyProjectProfileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="14,12" Background="#FFEAF5FF" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AppIcon Kind="Info" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusNotice}"
                               Margin="0,0,16,0"
                               FontSize="10.5"
                               Foreground="#315F8C"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2" Padding="8,4" Background="#FFFFFFFF" CornerRadius="7" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Sessions.Count, StringFormat=共 {0} 条}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="940">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,10"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ContinueConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Card"
                                                    Padding="18,15"
                                                    Background="#FFFFFFFF"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#FFF7FAFE" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FFB8D5EF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#FFEAF5FF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Card" Property="Opacity" Value="0.52" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"
                                                           MaxWidth="540"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Margin="9,0,0,0" Padding="6,3" Background="#FFF3F3F5" CornerRadius="7">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="8.5"
                                                               Foreground="{StaticResource TertiaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <TextBlock Text="{Binding Cli}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text=" · " FontSize="9.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                                <TextBlock Text="{Binding Connection}" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text=" · " FontSize="9.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                                <TextBlock Text="{Binding UpdatedAt}" FontSize="9.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="进入命令行"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                            <controls:AppIcon Kind="ArrowRight"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="7,0,0,0"
                                                              Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Padding="42,30" Background="#FFF9FAFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                            <Border Width="50" Height="50" Background="{StaticResource AccentSoftBrush}" CornerRadius="16" HorizontalAlignment="Center">
                                <controls:AppIcon Kind="History" Width="22" Height="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="这个项目还没有历史会话"
                                       Margin="0,15,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <Button Content="新建会话"
                                    Command="{Binding StartNewConversationCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,18,0,0"
                                    MinHeight="34"
                                    Padding="16,0"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
