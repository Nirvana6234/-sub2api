<UserControl x:Class="LanAi.Workspace.Wpf.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls"
             Loaded="TerminalView_OnLoaded"
             Unloaded="TerminalView_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="返回"
                    Click="Return_OnClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinHeight="34"
                    Padding="14,0"
                    VerticalAlignment="Center" />

            <Border x:Name="RuntimeBadge"
                    Grid.Column="3"
                    Padding="11,6"
                    Background="#FFF1F1F4"
                    CornerRadius="10"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="RuntimeDot"
                             Width="7"
                             Height="7"
                             Fill="{StaticResource TertiaryTextBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="RuntimeStatusText"
                               Text="等待启动"
                               Margin="7,0,0,0"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="项目"
                               Margin="2,0,0,6"
                               FontSize="10"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                    <ComboBox x:Name="ProjectComboBox"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource WorkspaceComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="官方 CLI"
                               Margin="2,0,0,6"
                               FontSize="10"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                    <ComboBox x:Name="CliComboBox"
                              ItemsSource="{Binding CliOptions}"
                              SelectedItem="{Binding SelectedCli}"
                              Style="{StaticResource WorkspaceComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="连接中心来源"
                               Margin="2,0,0,6"
                               FontSize="10"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                    <Border Padding="11,8"
                            MinHeight="36"
                            Background="#FFF7F7F9"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <TextBlock Text="{Binding SelectedConnection}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="连接来源由连接中心统一控制。" />
                    </Border>
                </StackPanel>

                <Button x:Name="StartButton"
                        Grid.Column="6"
                        Margin="0,20,0,0"
                        Content="启动终端"
                        Click="StartTerminal_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Name="StopButton"
                        Grid.Column="8"
                        Margin="0,20,0,0"
                        Content="停止"
                        Click="StopTerminal_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                MinHeight="300"
                Background="{StaticResource TerminalBrush}"
                BorderBrush="#FF34343A"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Grid Background="{StaticResource TerminalSecondaryBrush}">
                    <StackPanel Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FFFF5F57" />
                        <Ellipse Width="10" Height="10" Margin="8,0,0,0" Fill="#FFFFBD2E" />
                        <Ellipse Width="10" Height="10" Margin="8,0,0,0" Fill="#FF28C840" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="TerminalTitleText"
                                   Text="共飞AI工作台"
                                   MaxWidth="430"
                                   FontSize="11"
                                   Foreground="#FFC6C6CC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  ·  " FontSize="10" Foreground="#FF65656C" />
                        <TextBlock x:Name="TerminalSizeText"
                                   Text="120 × 36"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="9.5"
                                   Foreground="#FF85858C" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            Margin="0,0,14,0"
                            Padding="9,4"
                            Background="#FF35353A"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ConPTY"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFB8B8BE" />
                            <TextBlock Text="  UTF-8"
                                       FontSize="9.5"
                                       Foreground="#FF797980" />
                        </StackPanel>
                    </Border>
                </Grid>

                <controls:TerminalControl x:Name="TerminalSurface"
                                          Grid.Row="1"
                                          Margin="2"
                                          DimensionsChanged="TerminalSurface_OnDimensionsChanged"
                                          InputFailed="TerminalSurface_OnInputFailed"
                                          ToolTip="单击后输入；Ctrl+Shift+V 粘贴，滚轮回看输出" />

                <Border Grid.Row="2"
                        Margin="12,0,12,10"
                        Padding="12,8"
                        Background="#FF242428"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TerminalNoticeText"
                                   Text="终端已就绪"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                   FontSize="10.5"
                                   Foreground="#FFB9B9BF"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
