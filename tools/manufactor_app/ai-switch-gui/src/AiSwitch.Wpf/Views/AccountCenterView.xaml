<UserControl x:Class="LanAi.Workspace.Wpf.Views.AccountCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls"
             Loaded="AccountCenterView_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="AccountUsageTrackStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="#FFE9ECF1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4.5" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4.5"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountCompactUsageTrackStyle" TargetType="ProgressBar" BasedOn="{StaticResource AccountUsageTrackStyle}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Width" Value="96" />
        </Style>
        <Style x:Key="AccountMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
        </Style>
        <Style x:Key="AccountMetaValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AccountDetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
        </Style>
        <Style x:Key="AccountDetailValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AccountStatusPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#FFE9F8F0" />
            <Setter Property="CornerRadius" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="已停用"><Setter Property="Background" Value="#FFF0F0F3" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="异常"><Setter Property="Background" Value="#FFFFECEA" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="限流中"><Setter Property="Background" Value="#FFFFF3DF" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="过载中"><Setter Property="Background" Value="#FFFFF3DF" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="暂不可用"><Setter Property="Background" Value="#FFFFF3DF" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF168A55" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="已停用"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="异常"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="限流中"><Setter Property="Foreground" Value="#FFB66B08" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="过载中"><Setter Property="Foreground" Value="#FFB66B08" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="暂不可用"><Setter Property="Foreground" Value="#FFB66B08" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountHealthPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#FFE9F8F0" />
            <Setter Property="CornerRadius" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthStatusLabel}" Value="需关注"><Setter Property="Background" Value="#FFFFECEA" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountHealthTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF168A55" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthStatusLabel}" Value="需关注"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountHealthMessageStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="账号中心" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="添加并管理本机后台中的个人账号" Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="12,8" Margin="0,0,10,0" Background="#FFF0F4FA" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding SourceName}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Margin="0,0,10,0" Command="{Binding BeginAddCommand}" Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock FontSize="17" Text="+" /><TextBlock Margin="7,0,0,0" Text="添加账号" /></StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="强制刷新当前页">
                            <StackPanel Orientation="Horizontal"><controls:AppIcon Kind="Refresh" Width="15" Height="15" /><TextBlock Margin="7,0,0,0" Text="刷新" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,16" Padding="14,11" Background="#FFF4F7FB" BorderBrush="#FFE1E8F1" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Margin="20,0,0,0" Text="{Binding UpdatedLabel}" FontSize="11.5" Foreground="{StaticResource TertiaryTextBrush}" />
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Margin="0,0,10,0" Padding="18,16" Style="{StaticResource CardBorderStyle}">
                        <StackPanel><TextBlock Text="账号总数" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Margin="0,8,0,0" Text="{Binding TotalAccounts}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="18,16" Style="{StaticResource CardBorderStyle}">
                        <StackPanel><TextBlock Text="启用账号" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Margin="0,8,0,0" Text="{Binding ActiveAccounts}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    </Border>
                    <Border Padding="18,16" Style="{StaticResource CardBorderStyle}">
                        <StackPanel><TextBlock Text="需处理账号" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Margin="0,8,0,0" Text="{Binding AttentionAccounts}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Margin="22,18,22,16"><TextBlock Text="我的账号" Style="{StaticResource SectionTitleStyle}" /><TextBlock Margin="0,5,0,0" Text="调度顺序、运行状态与上游用量" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                        <Border Height="1" Background="{StaticResource HairlineBrush}" />
                        <Border Padding="18,16" Background="#FFFAFBFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Width="230" Margin="0,0,12,10">
                                        <TextBlock Text="搜索账号" Style="{StaticResource AccountDetailLabelStyle}" />
                                        <TextBox Margin="0,7,0,0" Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入账号名称、平台或代理" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,10">
                                        <TextBlock Text="平台" Style="{StaticResource AccountDetailLabelStyle}" />
                                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding PlatformFilterOptions}" SelectedItem="{Binding SelectedPlatformFilter}" DisplayMemberPath="Label" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,10">
                                        <TextBlock Text="状态" Style="{StaticResource AccountDetailLabelStyle}" />
                                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,21,0,10" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Margin="0,0,10,0" Text="{Binding FilteredSummaryLabel}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置筛选" Command="{Binding ResetFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </WrapPanel>
                                <Border Height="1" Margin="0,4,0,12" Background="{StaticResource HairlineBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsAllVisibleSelected, Mode=TwoWay}" Content="全选本页" Style="{StaticResource WorkspaceCheckBoxStyle}" />
                                        <TextBlock Margin="14,0,0,0" Text="{Binding SelectionLabel}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Content="批量检测" Command="{Binding TestSelectedAccountsCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,0,8,0" Content="批量修改" Command="{Binding BeginBatchEditCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,0,8,0" Content="批量删除" Command="{Binding DeleteSelectedAccountsCommand}" IsEnabled="{Binding HasSelection}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="清除选择" Command="{Binding ClearSelectionCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="AccountItems"
                                      ItemsSource="{Binding Accounts}"
                                      AllowDrop="True"
                                      DragOver="AccountItems_OnDragOver"
                                      DragLeave="AccountItems_OnDragLeave"
                                      Drop="AccountItems_OnDrop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="16,5" Padding="14,9" CornerRadius="7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="#FFDDE2EA" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                            <Condition Binding="{Binding DropInsertAfter}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#FFF5F9FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1,3,1,1" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True" />
                                                            <Condition Binding="{Binding DropInsertAfter}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#FFF5F9FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1,1,1,3" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22"
                                                        Height="42"
                                                        Margin="-4,0,2,0"
                                                        Background="Transparent"
                                                        Cursor="SizeAll"
                                                        Tag="{Binding}"
                                                        ToolTip="拖动调整账号调度顺序"
                                                        PreviewMouseLeftButtonDown="AccountDragHandle_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="AccountDragHandle_OnPreviewMouseMove">
                                                    <controls:AppIcon Kind="GripVertical" Width="12" Height="12" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <CheckBox Grid.Column="1" Margin="2,0,12,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="选择此账号" Style="{StaticResource WorkspaceCheckBoxStyle}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Margin="0,2,10,0" Text="{Binding IdentityLabel}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                                        <Border Margin="0,0,7,0" Padding="7,2" HorizontalAlignment="Left" Style="{StaticResource AccountStatusPillStyle}">
                                                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource AccountStatusTextStyle}" />
                                                        </Border>
                                                        <Border Padding="7,2" Background="#FFF0F4FA" CornerRadius="7">
                                                            <TextBlock Text="{Binding SchedulingOrderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="18,0,14,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Width="96" ToolTip="{Binding FiveHourDetail}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="5 小时" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FiveHourLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FF326AA8" />
                                                        </Grid>
                                                        <ProgressBar Margin="0,5,0,0" Value="{Binding FiveHourPercent}" Maximum="100" Foreground="#FF4C8ED9" Style="{StaticResource AccountCompactUsageTrackStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Width="96" Margin="16,0,0,0" ToolTip="{Binding SevenDayDetail}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="周额度" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SevenDayLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FF217A57" />
                                                        </Grid>
                                                        <ProgressBar Margin="0,5,0,0" Value="{Binding SevenDayPercent}" Maximum="100" Foreground="#FF35A879" Style="{StaticResource AccountCompactUsageTrackStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="4" Height="32" Background="#FFE9ECF1" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="5" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Margin="0,0,2,0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="打开完整账号测试" Command="{Binding DataContext.TestAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><controls:AppIcon Kind="Play" Width="13" Height="13" /></Button>
                                                    <Button Margin="0,0,2,0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="编辑账号设置" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><controls:AppIcon Kind="Edit" Width="13" Height="13" /></Button>
                                                    <Button Margin="0,0,2,0" Style="{StaticResource QuietIconButtonStyle}" Foreground="{StaticResource DangerBrush}" ToolTip="删除账号" Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><controls:AppIcon Kind="Delete" Width="13" Height="13" /></Button>
                                                    <Button Margin="0,0,2,0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="更多账号管理功能" Tag="{Binding}" Click="AccountMoreButton_OnClick"><controls:AppIcon Kind="More" Width="13" Height="13" /></Button>
                                                    <Button Margin="0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="展开用量与运行详情" Tag="{Binding}" Click="AccountDetailsButton_OnClick">
                                                        <controls:AppIcon Kind="ChevronRight" Width="13" Height="13" RenderTransformOrigin="0.5,0.5">
                                                            <controls:AppIcon.Style>
                                                                <Style TargetType="controls:AppIcon">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </controls:AppIcon.Style>
                                                        </controls:AppIcon>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Height="1" Margin="0,11,0,0" Background="#FFE9ECF1" />
                                            <Grid Margin="0,13,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.55*" MinWidth="360" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" MinWidth="310" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="额度窗口" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,3,0,0" Text="当前上游报告的窗口用量" FontSize="10.8" Foreground="{StaticResource TertiaryTextBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Margin="0,-6,-7,0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="重新查询该账号用量" Command="{Binding DataContext.RefreshAccountUsageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <controls:AppIcon Kind="Refresh" Width="13" Height="13" />
                                                            </Button>
                                                        </Grid>

                                                        <StackPanel Visibility="{Binding HasRollingUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="5 小时" FontSize="12" FontWeight="SemiBold" Foreground="#FF326AA8" />
                                                                <TextBlock Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Left" Text="{Binding FiveHourLabel}" FontSize="16" FontWeight="SemiBold" Foreground="#FF326AA8" />
                                                            </Grid>
                                                            <ProgressBar Margin="0,11,0,0" Value="{Binding FiveHourPercent}" Maximum="100" Foreground="#FF4C8ED9" Style="{StaticResource AccountUsageTrackStyle}" />
                                                            <TextBlock Margin="0,9,0,0" Text="{Binding FiveHourDetail}" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FiveHourDetail}" />

                                                            <Grid Margin="0,19,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="7 天" FontSize="12" FontWeight="SemiBold" Foreground="#FF217A57" />
                                                                <TextBlock Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Left" Text="{Binding SevenDayLabel}" FontSize="16" FontWeight="SemiBold" Foreground="#FF217A57" />
                                                            </Grid>
                                                            <ProgressBar Margin="0,11,0,0" Value="{Binding SevenDayPercent}" Maximum="100" Foreground="#FF35A879" Style="{StaticResource AccountUsageTrackStyle}" />
                                                            <TextBlock Margin="0,9,0,0" Text="{Binding SevenDayDetail}" FontSize="10.8" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SevenDayDetail}" />
                                                        </StackPanel>

                                                        <TextBlock Margin="0,6,0,0" Text="{Binding LocalUsageLabel}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="{Binding HasLocalUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Margin="0,8,0,0" Text="{Binding UsageError}" FontSize="11.5" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <ProgressBar Width="72" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsUsageLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Grid.Column="1" Margin="24,0" Background="#FFE9ECF1" />
                                                <StackPanel Grid.Column="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="健康状态" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,3,0,0" Text="本机账号的实时运行状态" FontSize="10.8" Foreground="{StaticResource TertiaryTextBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource AccountHealthPillStyle}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding HealthStatusLabel}" Style="{StaticResource AccountHealthTextStyle}" />
                                                        </Border>
                                                    </Grid>

                                                    <Border Margin="0,13,0,0" Padding="13" Background="#FFF7F9FC" BorderBrush="#FFE5E9F0" BorderThickness="1" CornerRadius="10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding HealthSummaryLabel}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding HealthSummaryLabel}" />
                                                            <Grid Margin="0,13,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,12,0"><TextBlock Text="运行状态" Style="{StaticResource AccountMetaLabelStyle}" /><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource AccountMetaValueStyle}" /></StackPanel>
                                                                <StackPanel Grid.Column="1"><TextBlock Text="调度能力" Style="{StaticResource AccountMetaLabelStyle}" /><TextBlock Text="{Binding SchedulableLabel}" Style="{StaticResource AccountMetaValueStyle}" /></StackPanel>
                                                            </Grid>
                                                            <Grid Margin="0,13,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,12,0"><TextBlock Text="最近使用" Style="{StaticResource AccountMetaLabelStyle}" /><TextBlock Text="{Binding LastUsedLabel}" Style="{StaticResource AccountMetaValueStyle}" /></StackPanel>
                                                                <StackPanel Grid.Column="1"><TextBlock Text="提交时间" Style="{StaticResource AccountMetaLabelStyle}" /><TextBlock Text="{Binding SubmittedLabel}" Style="{StaticResource AccountMetaValueStyle}" /></StackPanel>
                                                            </Grid>
                                                            <TextBlock Margin="0,13,0,0" Text="异常信息" Style="{StaticResource AccountMetaLabelStyle}" />
                                                            <TextBlock Text="{Binding HealthMessageLabel}" Style="{StaticResource AccountHealthMessageStyle}" ToolTip="{Binding ErrorMessage}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Height="1" Margin="0,17,0,15" Background="#FFE9ECF1" />
                                                    <TextBlock Text="调度与连接" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,3,0,12" Text="{Binding SchedulingLabel}" FontSize="10.8" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                                    <StackPanel><TextBlock Text="连接方式" Style="{StaticResource AccountMetaLabelStyle}" /><TextBlock Text="{Binding ProxyLabel}" Style="{StaticResource AccountMetaValueStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProxyLabel}" /></StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="28,38" Background="#FFFCFCFD" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" Background="#FFEAF3FF" CornerRadius="14"><controls:AppIcon Kind="Accounts" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Margin="0,14,0,0" Text="暂无可显示的账号" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Margin="0,7,0,0" Text="登录当前来源后，这里会显示属于自己的账号" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" /></StackPanel></Border>
                        <Grid Margin="22,12,22,18" Visibility="{Binding HasAccounts, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" HorizontalAlignment="Left" Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource SecondaryButtonStyle}" /><TextBlock Grid.Column="1" Text="{Binding PageLabel}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /><Button Grid.Column="2" HorizontalAlignment="Right" Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="AddAccountOverlay"
                Panel.ZIndex="30"
                Background="#66000000"
                Visibility="{Binding IsAdding, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsVisibleChanged="AddAccountOverlay_OnIsVisibleChanged">
            <Border Width="820" MaxHeight="760" Margin="24" Padding="24" Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="添加个人账号" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0" Text="账号直接接入本机中转；可选择 API Key 或 OpenAI / Codex 凭据流程" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="取消" Command="{Binding CancelAddCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="平台" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <ComboBox Margin="0,7,0,14" ItemsSource="{Binding AddPlatformOptions}" SelectedItem="{Binding SelectedAddPlatform}" DisplayMemberPath="Label" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="接入方式" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <ComboBox Margin="0,7,0,14" ItemsSource="{Binding AddModeOptions}" SelectedItem="{Binding SelectedAddMode}" DisplayMemberPath="Label" IsEnabled="{Binding IsAddOpenAi}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsAddOpenAiOAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="OpenAI / Codex 凭据方式" Style="{StaticResource AccountDetailLabelStyle}" />
                                <ComboBox Margin="0,7,0,14" ItemsSource="{Binding OpenAiMethodOptions}" SelectedItem="{Binding SelectedOpenAiMethod}" DisplayMemberPath="Label" Style="{StaticResource WorkspaceComboBoxStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="账号名称（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <TextBox Margin="0,7,0,14" Text="{Binding AddName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding IsAddApiKeyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="上游地址（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <TextBox Margin="0,7,0,14" Text="{Binding AddBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空时使用平台默认地址" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding UsesAddSecret, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding AddSecretLabel}" Style="{StaticResource AccountDetailLabelStyle}" />
                                <PasswordBox x:Name="AddAccountSecretInput" Margin="0,7,0,14" Padding="10,7" PasswordChanged="AddAccountSecretInput_OnPasswordChanged" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding UsesAddOAuthDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Codex 会话 / auth.json" Style="{StaticResource AccountDetailLabelStyle}" />
                                <Grid Margin="0,7,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="选择文件" Command="{Binding SelectAddOAuthFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding AddOAuthFilesLabel}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="也可以直接粘贴凭据 JSON" Style="{StaticResource AccountDetailLabelStyle}" />
                                <TextBox Margin="0,7,0,14" MinHeight="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Text="{Binding AddOAuthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding UsesAddManualCallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Content="生成并打开授权页面" Command="{Binding GenerateOpenAiAuthorizationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="重新打开" Command="{Binding OpenGeneratedAuthorizationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="授权回调地址" Style="{StaticResource AccountDetailLabelStyle}" />
                                <TextBox Margin="0,7,0,14" MinHeight="78" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding AddOAuthText, UpdateSourceTrigger=PropertyChanged}" ToolTip="粘贴包含 code 和 state 的完整回调地址" Style="{StaticResource WorkspaceTextBoxStyle}" />
                            </StackPanel>

                            <Border Margin="0,2,0,14" Padding="14" Background="#FFF7F9FC" BorderBrush="#FFE1E6EE" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="调度与连接" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,12" Text="个人账号自动进入主账号池，并始终优先用于本机请求" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="连接代理" Style="{StaticResource AccountDetailLabelStyle}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Padding="9,4" Content="{Binding AddProxyEditorToggleLabel}" Command="{Binding ToggleAddProxyEditorCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                            <ComboBox Margin="0,7,0,14" ItemsSource="{Binding AddProxyOptions}" SelectedItem="{Binding SelectedAddProxy}" Style="{StaticResource WorkspaceComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="测试模型（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                            <TextBox Margin="0,7,0,14" Text="{Binding AddTestModelId, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空时由后台自动选择" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,14" Visibility="{Binding IsAddProxyEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Separator Margin="0,0,0,12" />
                                        <TextBlock Text="新增连接代理" FontSize="12.5" FontWeight="SemiBold" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="代理名称" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <TextBox Margin="0,7,0,12" Text="{Binding AddProxyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="协议" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <ComboBox Margin="0,7,0,12" ItemsSource="{Binding AddProxyProtocolOptions}" SelectedItem="{Binding SelectedAddProxyProtocol}" DisplayMemberPath="Label" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="主机或 IP" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <TextBox Margin="0,7,0,12" Text="{Binding AddProxyHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 127.0.0.1；不要填写 http://" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="端口" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <TextBox Margin="0,7,0,12" Text="{Binding AddProxyPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="用户名（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <TextBox Margin="0,7,0,0" Text="{Binding AddProxyUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="密码（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                                <PasswordBox x:Name="AddProxyPasswordInput" Margin="0,7,0,0" Padding="10,7" PasswordChanged="AddProxyPasswordInput_OnPasswordChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,12,0" Text="{Binding AddProxyValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="保存代理" Command="{Binding CreateAddProxyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="并发数" Style="{StaticResource AccountDetailLabelStyle}" /><TextBox Margin="0,7,0,0" Text="{Binding AddConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="调度负载" Style="{StaticResource AccountDetailLabelStyle}" /><TextBox Margin="0,7,0,0" Text="{Binding AddLoadFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,10" Text="{Binding AddValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Margin="0,0,10,0" Content="取消" Command="{Binding CancelAddCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="添加到本机中转" Command="{Binding SaveAddCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
        <Border Panel.ZIndex="40"
                Background="#73000000"
                Visibility="{Binding IsTestDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="780" MaxHeight="760" Margin="24" Padding="24" Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="账号连接测试" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0" Text="选择该账号实际可用的模型，并查看本机后台返回的完整测试过程" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseAccountTestCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Padding="14" Background="#FFF6F8FB" BorderBrush="#FFE1E6EE" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TestingAccount.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding TestingAccount.IdentityLabel}" FontSize="11.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="9,4" Style="{StaticResource AccountStatusPillStyle}" DataContext="{Binding TestingAccount}">
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource AccountStatusTextStyle}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="测试模型" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <ComboBox Margin="0,7,0,0" ItemsSource="{Binding TestModels}" SelectedItem="{Binding SelectedTestModel}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanStartDetailedTest}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding IsTestingOpenAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="OpenAI 测试模式" Style="{StaticResource AccountDetailLabelStyle}" />
                                    <ComboBox Margin="0,7,0,0" ItemsSource="{Binding TestModeOptions}" SelectedItem="{Binding SelectedTestMode}" DisplayMemberPath="Label" IsEnabled="{Binding CanStartDetailedTest}" Style="{StaticResource WorkspaceComboBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="测试提示词（可选）" Style="{StaticResource AccountDetailLabelStyle}" />
                                <TextBox Margin="0,7,0,0" MinHeight="58" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding TestPrompt, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStartDetailedTest}" ToolTip="文本或图片模型需要自定义测试内容时填写；留空使用后台默认内容" Style="{StaticResource WorkspaceTextBoxStyle}" />
                            </StackPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="后台测试输出" FontSize="12.5" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Margin="0,-7,-7,0" Style="{StaticResource QuietIconButtonStyle}" ToolTip="复制测试日志" Command="{Binding CopyTestOutputCommand}"><controls:AppIcon Kind="Copy" Width="14" Height="14" /></Button>
                            </Grid>
                            <Border Margin="0,8,0,0" MinHeight="150" MaxHeight="270" Padding="14" Background="#FF111827" BorderBrush="#FF293244" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding TestLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,5" Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FFD1D5DB" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="muted"><Setter Property="Foreground" Value="#FF94A3B8" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="model"><Setter Property="Foreground" Value="#FF67E8F9" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="status"><Setter Property="Foreground" Value="#FFFACC15" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="content"><Setter Property="Foreground" Value="#FFE5E7EB" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="success"><Setter Property="Foreground" Value="#FF4ADE80" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="error"><Setter Property="Foreground" Value="#FFF87171" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding TestImages}" Visibility="{Binding HasTestImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="0,0,10,10" Padding="7" Background="#FFF7F9FC" BorderBrush="#FFE1E6EE" BorderThickness="1" CornerRadius="8">
                                            <StackPanel><Image MaxHeight="190" Source="{Binding Source}" Stretch="Uniform" /><TextBlock Margin="0,6,0,0" Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ProgressBar Margin="0,13,0,0" Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsTestRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding TestStatusMessage}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True"><Setter Property="Foreground" Value="#FF168A55" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TestFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,10,0" Content="关闭" Command="{Binding CloseAccountTestCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding StartDetailedAccountTestCommand}" IsEnabled="{Binding CanStartDetailedTest}" Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal"><controls:AppIcon Kind="Play" Width="14" Height="14" /><TextBlock Margin="6,0,0,0" Text="{Binding DetailedTestButtonLabel}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <Border Panel.ZIndex="20" Background="#66000000" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="720" MaxHeight="720" Margin="24" Padding="24" Background="White" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding EditTitle}" FontSize="19" FontWeight="SemiBold" /><TextBlock Margin="0,5,0,0" Text="{Binding EditSubtitle}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><Button Grid.Column="1" Content="取消" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <StackPanel Visibility="{Binding ShowSingleAccountName, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="名称" Style="{StaticResource AccountDetailLabelStyle}" /><TextBox Margin="0,7,0,14" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" /></StackPanel>
                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="并发数" Style="{StaticResource AccountDetailLabelStyle}" /><TextBox Margin="0,7,0,0" Text="{Binding EditConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="调度负载" Style="{StaticResource AccountDetailLabelStyle}" /><TextBox Margin="0,7,0,0" Text="{Binding EditLoadFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceTextBoxStyle}" /></StackPanel>
                            </Grid>
                            <TextBlock Text="连接代理" Style="{StaticResource AccountDetailLabelStyle}" /><ComboBox Margin="0,7,0,4" ItemsSource="{Binding ProxyOptions}" SelectedItem="{Binding SelectedProxy}" Style="{StaticResource WorkspaceComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TertiaryTextBrush}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBlock Margin="0,10,0,0" Text="{Binding EditValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Margin="0,0,10,0" Content="取消" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="保存设置" Command="{Binding SaveEditCommand}" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
