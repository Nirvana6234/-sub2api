<UserControl x:Class="LanAi.Workspace.Wpf.Views.GatewayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls"
             Loaded="GatewayView_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="HealthBeaconStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailure}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewaySectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="GatewayMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="GatewayMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="GatewayMetricCellStyle" TargetType="Border">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="Background" Value="#FFF7F7F9" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style x:Key="GatewaySignalStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#FFEAF8F0" />
            <Setter Property="BorderBrush" Value="#FFD1ECDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQuotaWarning}" Value="True">
                    <Setter Property="Background" Value="#FFFFF6E8" />
                    <Setter Property="BorderBrush" Value="#FFF2D6A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTodayFailures}" Value="True">
                    <Setter Property="Background" Value="#FFFFEFEC" />
                    <Setter Property="BorderBrush" Value="#FFF3CFC7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewaySignalDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQuotaWarning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTodayFailures}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewayConnectionDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewayRecoveryDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAutomaticRecoveryFailure}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewayTextButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonBaseStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="确认中转是否可用，查看自己的服务摘要，并完成后台访问与服务操作。"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0"
                               Text="{Binding CacheStatusLabel}"
                               FontSize="11"
                               Foreground="{StaticResource TertiaryTextBrush}"
                               VerticalAlignment="Center" />
                    <Button Margin="0,0,10,0"
                            Padding="12,7"
                            Content="刷新"
                            Command="{Binding RefreshStatusCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="手动读取当前来源；切换页面不会自动刷新" />
                    <Border Padding="12,7"
                            Background="#FFF0F0F3"
                            CornerRadius="11"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="42"
                                         Height="3"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#FFD8D8DC"
                                         VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0"
                                       Text="{Binding CurrentOperation}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 第一主区域：用户第一眼只需要确认服务是否可用。 -->
            <Border Margin="0,0,0,18"
                    Padding="28,25"
                    Background="#FF172033"
                    CornerRadius="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="66" Height="66" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Fill="#12FFFFFF" />
                        <Ellipse Width="46" Height="46" Fill="#1CFFFFFF" />
                        <Ellipse Width="26" Height="26" Fill="#26FFFFFF" />
                        <Ellipse Width="12" Height="12" Style="{StaticResource HealthBeaconStyle}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GatewaySummary}"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding GatewayUsageHint}"
                                   FontSize="13.5"
                                   Foreground="#D8FFFFFF"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding StatusNotice}"
                                   FontSize="12"
                                   Foreground="#9FFFFFFF"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource GatewayRecoveryDotStyle}" />
                            <TextBlock Text="{Binding AutomaticRecoveryLabel}"
                                       FontSize="11.5"
                                       Foreground="#BFFFFFFF"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Margin="26,0,0,0"
                            MinWidth="176"
                            Content="{Binding PrimaryGatewayActionLabel}"
                            Command="{Binding PrimaryGatewayActionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 第二主区域：远程来源只显示账户摘要，本机来源才显示进程控制。 -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" MinWidth="580" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Grid.ColumnSpan="{Binding ServiceSummaryColumnSpan}">
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="24"
                            Visibility="{Binding ShowSignedOutSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="我的服务" Style="{StaticResource GatewaySectionTitleStyle}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="登录一次后，工作台会安全恢复会话，并在这里显示余额和今天的使用情况。"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding BackendSourceLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,22,0,0"
                                        Visibility="{Binding ShowLoginPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Content="登录当前后台账户"
                                        Command="{Binding BeginLoginCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <TextBlock Margin="0,10,0,0"
                                           Text="账户密码只用于本次登录，密码不会保存。"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>

                            <Border Margin="0,20,0,0"
                                    Padding="18"
                                    Background="#FFF7F7F9"
                                    CornerRadius="14"
                                    Visibility="{Binding ShowLoginEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="账户邮箱" Style="{StaticResource GatewayMetricLabelStyle}" />
                                        <TextBox Margin="0,7,0,0"
                                                 Padding="11,8"
                                                 Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="账户密码" Style="{StaticResource GatewayMetricLabelStyle}" />
                                        <PasswordBox x:Name="LocalAccountPasswordBox"
                                                     Margin="0,7,0,0"
                                                     Padding="11,8" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding LoginStatus}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Grid.Row="4"
                                                Grid.ColumnSpan="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Margin="0,0,8,0"
                                                Content="取消"
                                                Command="{Binding CancelLoginCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="登录并读取摘要"
                                                Click="LoginLocalAccountButton_OnClick"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="24"
                            Visibility="{Binding ShowSignedInSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="我的服务" Style="{StaticResource GatewaySectionTitleStyle}" />
                                    <Border Margin="12,0,0,0"
                                            Padding="9,4"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="9">
                                        <TextBlock Text="{Binding LoginRoleLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,4,0"
                                            Content="更新摘要"
                                            Command="{Binding RefreshServiceSummaryCommand}"
                                            Style="{StaticResource GatewayTextButtonStyle}" />
                                    <Button Content="退出登录"
                                            Command="{Binding LogoutCommand}"
                                            Style="{StaticResource GatewayTextButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="3" Margin="-5,20,-5,0">
                                <Border Style="{StaticResource GatewayMetricCellStyle}">
                                    <StackPanel>
                                        <TextBlock Text="站内余额" Style="{StaticResource GatewayMetricLabelStyle}" />
                                        <TextBlock Text="{Binding AccountBalanceLabel}" Style="{StaticResource GatewayMetricValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GatewayMetricCellStyle}">
                                    <StackPanel>
                                        <TextBlock Text="今日请求" Style="{StaticResource GatewayMetricLabelStyle}" />
                                        <TextBlock Text="{Binding TodayRequestLabel}" Style="{StaticResource GatewayMetricValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GatewayMetricCellStyle}">
                                    <StackPanel>
                                        <TextBlock Text="今日实际扣费" Style="{StaticResource GatewayMetricLabelStyle}" />
                                        <TextBlock Text="{Binding TodayActualCostLabel}" Style="{StaticResource GatewayMetricValueStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,18,0,0" Style="{StaticResource GatewaySignalStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9"
                                             Height="9"
                                             Style="{StaticResource GatewaySignalDotStyle}"
                                             VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="11,0,12,0">
                                        <TextBlock Text="{Binding UserServiceStatusLabel}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run Text="{Binding PlatformQuotaLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding RecentFailureLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="查看详细用量"
                                            Command="{Binding DataContext.OpenUsageDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource GatewayTextButtonStyle}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="16,14"
                                    Background="#FFF3F5FA"
                                    CornerRadius="13"
                                    Visibility="{Binding ShowAdministratorSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AdministratorHealthHeadline}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding AdministratorHealthDetail}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding ServiceUpdateLabel}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Visibility="{Binding HasServiceUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               Text="全站"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="24"
                        Visibility="{Binding ShowLocalServiceControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="本机服务操作" Style="{StaticResource GatewaySectionTitleStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="当前来源为本机中转时，可在这里重启或停止本机服务。"
                                   FontSize="12.5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,14,0,0"
                                Padding="14,12"
                                Background="#FFF2F6FC"
                                BorderBrush="#FFDCE6F3"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="本机启动工作区" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding NativeRootDisplayPath}"
                                               FontSize="10.8"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NativeRootDisplayPath}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           MaxWidth="260"
                                           Text="请在“连接中心 → 本机中转 → 编辑”中修改"
                                           FontSize="11"
                                           Foreground="{StaticResource TertiaryTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="14,12"
                                Background="#FFF7F7F9"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="本机后台" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding WebStatusLabel}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="-5,16,-5,0">
                            <Button Margin="5,0"
                                    Content="重启服务"
                                    Command="{Binding RestartGatewayCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="5,0"
                                    Content="停止服务"
                                    Command="{Binding StopGatewayCommand}"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 用户摘要：只补充今天的实际使用和客户端是否可用。 -->
            <Grid Margin="0,0,0,18"
                  Visibility="{Binding ShowSignedInSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="350" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.6*" MinWidth="560" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="22" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="今日使用" Style="{StaticResource GatewaySectionTitleStyle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="今天实际产生的 Token，以及当前可用于调用的密钥。"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <UniformGrid Columns="2" Margin="-5,18,-5,0">
                            <Border Style="{StaticResource GatewayMetricCellStyle}">
                                <StackPanel>
                                    <TextBlock Text="今日 Token" Style="{StaticResource GatewayMetricLabelStyle}" />
                                    <TextBlock Text="{Binding TodayTokenLabel}" Style="{StaticResource GatewayMetricValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GatewayMetricCellStyle}">
                                <StackPanel>
                                    <TextBlock Text="API Key" Style="{StaticResource GatewayMetricLabelStyle}" />
                                    <TextBlock Text="{Binding ApiKeyStatusLabel}"
                                               Style="{StaticResource GatewayMetricValueStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="22" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="客户端连接" Style="{StaticResource GatewaySectionTitleStyle}" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding ConnectionHealthStatus}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Content="检测连接"
                                    Command="{Binding ProbeConnectionsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl Margin="-5,16,-5,0" ItemsSource="{Binding ConnectionHealth}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5,0"
                                            Padding="15,13"
                                            Background="#FFF7F7F9"
                                            CornerRadius="13">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Style="{StaticResource GatewayConnectionDotStyle}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,8,0"
                                                           Text="{Binding Client}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LatestLatency}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </Grid>
                                            <TextBlock Margin="16,7,0,0"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="16,4,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TertiaryTextBrush}">
                                                <Run Text="近 24 小时成功率 " />
                                                <Run Text="{Binding SuccessRate, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第三主区域：日志默认收起，需要时再看。 -->
            <Expander Header="查看操作日志" Margin="0,0,0,4">
                <Border Margin="0,12,0,0"
                        Background="#FF19191C"
                        BorderBrush="#FF2A2A2E"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#FFFF5F57" />
                                <Ellipse Margin="6,0,0,0" Width="8" Height="8" Fill="#FFFFBD2E" />
                                <Ellipse Margin="6,0,0,0" Width="8" Height="8" Fill="#FF28C840" />
                                <TextBlock Margin="12,0,0,0"
                                           Text="本次操作日志"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE8E8ED" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="清空"
                                    Command="{Binding ClearLogCommand}"
                                    Padding="10,5"
                                    Background="#FF2A2A2E"
                                    Foreground="#FFAEAEB2"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>
                        <TextBox x:Name="OperationLogTextBox"
                                 Grid.Row="1"
                                 MinHeight="150"
                                 MaxHeight="280"
                                 Padding="18,13,18,18"
                                 Text="{Binding OperationLog, Mode=OneWay}"
                                 TextChanged="OperationLogTextBox_OnTextChanged"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#FF19191C"
                                 Foreground="#FFB7F1C0"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 SelectionBrush="#66007AFF" />
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
