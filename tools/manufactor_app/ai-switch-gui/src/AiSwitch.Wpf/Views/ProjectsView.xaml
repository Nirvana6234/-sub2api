<UserControl x:Class="LanAi.Workspace.Wpf.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanAi.Workspace.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,4,0,0" Orientation="Horizontal">
                    <TextBox Width="220"
                             Style="{StaticResource WorkspaceTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索项目名称或目录" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding RequestCleanupInvalidProjectsCommand}"
                            Content="清理失效项目">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#C83E42" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInvalidProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshProjectsCommand}"
                            Content="刷新" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddProjectCommand}"
                            Content="添加项目" />
                </StackPanel>
            </Grid>

            <Border Margin="0,0,0,18" Padding="14,12" Background="#EAF4FF" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AppIcon Kind="Info" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusNotice}"
                               FontSize="12"
                               Foreground="#315F8C"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Margin="0,0,0,18"
                    Padding="16,14"
                    Background="#FFF5F2F2"
                    BorderBrush="#22C83E42"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCleanupConfirmationVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="确认清理失效项目？"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#9D292D" />
                        <TextBlock Margin="0,5,20,0"
                                   Text="{Binding CleanupWarning}"
                                   FontSize="10.5"
                                   Foreground="#7B4648"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="取消"
                                Command="{Binding CancelCleanupInvalidProjectsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="34"
                                Padding="14,0" />
                        <Button Margin="8,0,0,0"
                                Content="永久清理"
                                Command="{Binding ConfirmCleanupInvalidProjectsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="#C83E42"
                                BorderBrush="#C83E42"
                                MinHeight="34"
                                Padding="14,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="332"
                                MinHeight="224"
                                Margin="0,0,14,14"
                                Padding="20,18"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="12">
                                        <TextBlock Text="{Binding Monogram}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding LastActivity}" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource TertiaryTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,4" Background="#FFF4F4F6" CornerRadius="8" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Path}"
                                           Margin="0,17,0,15"
                                           Padding="10,8"
                                           Background="#FFF7F7F9"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11.5"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="默认 CLI" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <TextBlock Text="{Binding PreferredCli}" Margin="0,5,0,0" FontSize="13.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource HairlineBrush}" />
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="默认连接" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <TextBlock Text="{Binding Connection}" Margin="0,5,0,0" FontSize="13.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,17,0,0">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="历史按此项目归档"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TertiaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="删除"
                                                Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Foreground="#C83E42"
                                                MinHeight="34"
                                                Padding="12,0" />
                                        <Button Grid.Column="3"
                                                Content="开始对话"
                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinHeight="34"
                                                Padding="14,0" />
                                    </Grid>

                                    <Border Padding="12,10"
                                            Background="#FFF5F2F2"
                                            BorderBrush="#22C83E42"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="确认永久删除这个项目？"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9D292D" />
                                            <TextBlock Margin="0,5,0,10"
                                                       Text="{Binding DeleteWarning}"
                                                       FontSize="11"
                                                       Foreground="#7B4648"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="取消"
                                                        Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        MinHeight="28"
                                                        Padding="12,0" />
                                                <Button Margin="8,0,0,0"
                                                        Content="永久删除"
                                                        Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Background="#C83E42"
                                                        BorderBrush="#C83E42"
                                                        MinHeight="28"
                                                        Padding="12,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
